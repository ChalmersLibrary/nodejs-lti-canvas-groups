# Copy to .env and fill in. .env is gitignored; this file is not, so never put a real
# secret or token in here.
#
# In Azure these are App Service application settings rather than a file. The names are
# the same. Every variable the application reads is listed below, and the ones marked
# optional have a working default.


# --- Required ---------------------------------------------------------------------------

# Consumer keys for the LTI launch, as "key:secret[,key:secret]". These are the values you
# put into the app integration in Canvas. The secret may itself contain a colon.
ltiConsumerKeys=canvas:change-me

# From the Canvas Developer Key for this application, under Details.
oauthClientId=
oauthClientSecret=

# Signs the session cookie. Any long random string; changing it invalidates every session.
SESSION_SECRET=change-me-to-something-long-and-random


# --- Environment ------------------------------------------------------------------------

# "development" enables debug logging and the mocked local session (see mock-lti.json),
# "production" turns on trust proxy and a Secure, Partitioned session cookie. Anything
# else, including unset, behaves like a plain local run.
NODE_ENV=development

# Port to listen on. Optional, default 3000.
PORT=3000

# Used to build the OAuth redirect uri. "localhost" gives http://localhost:3000, anything
# else gives https://<value>. Azure sets this for you; set it locally.
WEBSITE_HOSTNAME=localhost


# --- Canvas -----------------------------------------------------------------------------

# Overrides the Canvas api domain, and it wins over everything else: over
# custom_canvas_api_domain from a real launch and over the one in mock-lti.json. Normally
# leave it unset, so that a launch from test or beta Canvas talks to test or beta rather
# than to production.
#
# You do not need it for local development either: mock-lti.json carries
# custom_canvas_api_domain and that is honoured. Set it only to deliberately point somewhere
# else, or at a base that is not https, since the domain from a launch is always used as
# https://<domain>. Example: https://school.test.instructure.com
canvasBaseUri=

# Seconds to cache Canvas API responses. Optional, default 900.
canvasApiCacheSecondsTTL=900

# How many groups or categories are read from Canvas at the same time. Optional, default 5.
# Set it to 1 to read them strictly one after the other, should Canvas answer 403 because
# of its own rate limiting.
canvasApiConcurrency=5

# Canvas API token used by the anonymous public self signup endpoint, which has no user to
# borrow a token from. Optional; that endpoint returns nothing useful without it.
systemApiToken=

# Fallback email domain for the Zoom breakout room export, without the @.
# Example: student.school.se
#
# Zoom matches a pre-assignment against the address the user signs in with, which comes from
# the identity provider and follows their login. A student can set their primary email in
# Canvas to anything, a private address included, and that address is one Zoom has never heard
# of, so the pre-assignment silently skips them. The export therefore uses the login id and
# not the email.
#
# Where a login id already carries a domain, that domain is kept, so roles on different
# domains need no configuration and no role lookup: a teacher logging in as
# name@school.se stays there and a student on student.school.se stays there. This setting is
# only used for logins that are a bare account name with no domain to keep. Optional.
zoomEmailDomain=


# --- Access -----------------------------------------------------------------------------

# Canvas user ids, comma separated, that may see /stats, /dashboard and /json/stats. Long
# format LTI user id, the same value that shows up as user_id in the launch. Optional.
adminCanvasUserIds=

# Name of the session cookie. Optional, default groupTool.sid.
SESSION_NAME=groupTool.sid

# Extra origins to allow in the frame-src of the Content-Security-Policy header, appended
# to 'self'. Needed if Canvas is served from another host than the tool. Optional.
CSP_FRAME_SRC_ALLOW=

# OAuth state parameter, echoed back by Canvas and checked on the redirect. Optional;
# falls back to COMPUTERNAME and then to a built-in constant.
oauthClientState=


# --- Development and debugging -----------------------------------------------------------

# "true" logs the LTI launch body and the session on every launch. Leave it off in
# production: the launch body holds personal data about the user.
debugLogging=false

# "true" honours x-forwarded-proto and x-forwarded-host. Set it when Canvas reaches your
# localhost through an https tunnel: the LTI launch signature is computed over the url as
# this application sees it, and without this it sees http and its own host, so the
# signature cannot match whatever the shared secret is. Always on in production, where the
# Azure front end terminates https, so it only matters locally. Optional, default off.
trustProxy=false

# A Canvas API token of your own. With NODE_ENV=development this, together with
# mock-lti.json, fakes a launched session so the tool can be used without Canvas.
# Never set this in Azure.
localCanvasDeveloperToken=

# Path to the mocked launch data. Optional, default ./mock-lti.json. The tests point it at a
# file of their own so that they cannot write over the one you are developing against.
#MOCK_LTI_PATH=

# Path to the sqlite database file. Optional, default ./db/tokens.sqlite3.
#
# Point this OUTSIDE whatever your deploy replaces. The default puts the database inside the
# application directory, which is safe only if you deploy by git checkout into the existing
# directory, since that leaves untracked files alone. A zip deploy, which is what a GitHub
# Actions workflow normally does, unpacks the repository over that directory every time and
# takes the database with it; run from package mounts it read-only, so the application cannot
# write a database there at all. Losing the file means every user reauthorizes, which is
# silent, and every self signup rule a teacher has configured is gone for good.
#
# On Azure App Service use a path under /home other than /home/site, which is persistent
# storage that survives deploys and restarts. Example:
# /home/Data/grouptool/grouptool.sqlite
#
# See "Moving the database off the deployment target" in README.md for how to move an
# existing database without starting from an empty one. The tests also set this, so that they
# do not write into the database being developed against.
#
# Left commented out on purpose: it takes a path, so there is no sensible empty value.
#DB_PATH=
